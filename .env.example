# Copy to .env for local/EAS builds. Do not commit .env (gitignored).
# Set these in EAS Secrets for production: https://expo.dev/accounts/[account]/projects/blockrush/secrets

# --- AdMob production ad units (replace test ids from src/constants/monetization.ts) ---
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=

# Optional: privacy policy URL shown in About (future in-app link)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.com/privacy
